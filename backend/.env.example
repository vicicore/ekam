APP_NAME=SETU API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

PERSISTENCE_BACKEND=local
STORAGE_BACKEND=local
LOCAL_DATA_DIR=app/data
DEMO_MODE_ENABLED=true
ADMIN_IDENTIFIERS=["admin"]
SESSION_TTL_HOURS=720

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=change-me

MAX_UPLOAD_MB=5
SETU_ALLOWED_ORIGINS=http://localhost:3000
SETU_RATE_LIMIT_REQUESTS=120
SETU_RATE_LIMIT_WINDOW_SECONDS=60
SETU_MAX_UPLOAD_BYTES=10485760
SETU_REQUIRE_HTTPS=false
